{
  "name": "dart-mind",
  "displayName": "DartMind",
  "description": "DartMind is an intelligent VS Code extension that provides real-time code analysis for Dart and Flutter projects. It helps developers write cleaner, more maintainable code by analyzing cognitive complexity, detecting code smells, and offering performance insights.",
  "version": "0.0.1",
  "publisher": "YourPublisherName",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/dart-mind"
  },
  "keywords": [
    "dart",
    "flutter",
    "code analysis",
    "complexity"
  ],
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:dart"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "codeComplexity",
      "properties": {
        "codeComplexity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable code complexity analysis."
        }
      }
    },
    "commands": [
      {
        "command": "dartmind.showComplexity",
        "title": "Show Code Complexity"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.11.7",
    "typescript": "^4.5.5",
    "eslint": "^8.9.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0",
    "vscode-languageserver": "^8.1.0",
    "vscode-languageserver-protocol": "^3.17.3"
  }
}
